<Window x:Class="SmsTestWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://microsoft.com"
        xmlns:mc="http://openxmlformats.org"
        x:Name="RootWindow" 
        Height="450" Width="850"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">


    <Border CornerRadius="20" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="10">
        <Grid>
            <!-- ГЛАВНАЯ СЕТКА ОКНА -->
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ШАПКА ОКНА И КНОПКИ УПРАВЛЕНИЯ -->
            <DockPanel Grid.Row="0" Margin="20,0">
                <TextBlock 
                    Text="Тестовое WPF-приложение для SmartMealService" 
                    VerticalAlignment="Center" 
                    FontWeight="Bold" 
                    FontSize="13" 
                    Foreground="#333333"/>
                
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center">
                    
                    <Button Width="20" Height="20" 
                            Content="—" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Margin="0,0,10,0" 
                            Command="{Binding MinimizeCommand}" CommandParameter="{Binding ElementName=RootWindow}"/>
                    <Button Width="20" Height="20" 
                            Content="✖"
                            Background="Transparent" 
                            BorderThickness="0" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Command="{Binding CloseCommand}" CommandParameter="{Binding ElementName=RootWindow}"/>
                </StackPanel>
            </DockPanel>

            <!-- 2. СТИЛИЗОВАННАЯ ТАБЛИЦА И КНОПКИ УПРАВЛЕНИЯ -->
            <DockPanel Grid.Row="1" Margin="20,0,20,20">

                <!-- ПАНЕЛЬ КНОПОК В САМОМ НИЗУ ОКНА -->
                <StackPanel DockPanel.Dock="Bottom" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,15,0,0">
                    
                    <Button 
                        Content="Сбросить" 
                        Command="{Binding ResetCommand}" Width="110" Height="30" Margin="0,0,12,0" Background="#F3F4F6" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold"/>
                    
                    <Button 
                        Content="Сохранить изменения" 
                        Command="{Binding SaveCommand}" 
                        Width="160" 
                        Height="30"
                        Background="Black" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        FontWeight="SemiBold"/>
                </StackPanel>

                <!-- ОСНОВНОЙ КОНТУР ТАБЛИЦЫ -->
                <Border 
                    BorderBrush="Black" 
                    BorderThickness="2" 
                    CornerRadius="20" 
                    Background="Transparent">

                    <!-- ВОЗВРАЩАЕМ СЕТКУ GRID ДЛЯ СТРОГОРГО РАЗДЕЛЕНИЯ ВЫСОТЫ -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <!-- Строка 0: Шапка таблицы -->
                            <RowDefinition Height="*"/>
                            <!-- Строка 1: Данные таблицы -->
                        </Grid.RowDefinitions>

                        <!-- ВЕРХНЯЯ ШАПКА ТАБЛИЦЫ -->
                        <Border Grid.Row="0" 
                                CornerRadius="18,18,0,0" 
                                ClipToBounds="True" 
                                BorderBrush="Black" 
                                BorderThickness="0,0,0,1">
                           
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="" />
                                <Border Grid.Column="0" 
                                        BorderBrush="Black" 
                                        BorderThickness="0,0,1,0" 
                                        HorizontalAlignment="Right"/>

                                <TextBlock Grid.Column="1" 
                                           Text="Переменная среды" 
                                           VerticalAlignment="Center" 
                                           Padding="12,0" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"/>
                                <Border Grid.Column="1" 
                                        BorderBrush="Black" 
                                        BorderThickness="0,0,1,0" 
                                        HorizontalAlignment="Right"/>

                                <TextBlock Grid.Column="2"
                                           Text="Текущее значение" 
                                           VerticalAlignment="Center" 
                                           Padding="12,0" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"/>
                                <Border Grid.Column="2" 
                                        BorderBrush="Black" 
                                        BorderThickness="0,0,1,0" 
                                        HorizontalAlignment="Right"/>

                                <TextBlock Grid.Column="3" 
                                           Text="Комментарий" 
                                           VerticalAlignment="Center" 
                                           Padding="12,0" 
                                           FontSize="12" 
                                           FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <!-- НИЖНЯЯ ЧАСТЬ С ДАННЫМИ -->
                        <Border Grid.Row="1" CornerRadius="0,0,18,18" ClipToBounds="True">
                            <DataGrid
                                x:Name="MyDataGrid" 
                                ItemsSource="{Binding Variables}" 
                                AutoGenerateColumns="False" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                HeadersVisibility="None" 
                                CanUserAddRows="False" 
                                GridLinesVisibility="All" 
                                HorizontalGridLinesBrush="Black" 
                                VerticalGridLinesBrush="Black"
                                RowBackground="Transparent" 
                                SelectionUnit="FullRow">

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter 
                                            Property="IsSelected" 
                                            Value="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        
                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black" />
                                        </Style.Resources>
                                    
                                    </Style>
                                
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <!-- 1. ИНДИКАТОРЫ СТРОКИ -->
                                    <DataGridTemplateColumn Width="0.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center">
                                                    <TextBlock 
                                                        x:Name="ArrowIcon" 
                                                        Text="▶" 
                                                        FontSize="10" 
                                                        Foreground="Black" 
                                                        Margin="0,0,3,0" 
                                                        Visibility="Collapsed"/>
                                                    <TextBlock 
                                                        x:Name="StarIcon" 
                                                        Text="★" 
                                                        FontSize="11" 
                                                        Foreground="Black" 
                                                        Visibility="Collapsed"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="ArrowIcon" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                        <Setter TargetName="StarIcon" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 2. ИМЯ ПЕРЕМЕННОЙ -->
                                    <DataGridTextColumn Binding="{Binding Field}" Width="2*" IsReadOnly="True"/>

                                    <!-- 3. ВВОД ЗНАЧЕНИЯ -->
                                    <DataGridTemplateColumn Width="2.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox 
                                                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                    BorderThickness="0" 
                                                    Background="Transparent" 
                                                    TextWrapping="Wrap" 
                                                    AcceptsReturn="True" 
                                                    VerticalAlignment="Center" 
                                                    Padding="5,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 4. СТАТУС -->
                                    <DataGridTextColumn Binding="{Binding Comment}" Width="3*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </Border>

</Window>
