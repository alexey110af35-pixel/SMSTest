{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sms_test;Username=postgres;Password=postgres"
  },
  "ServerSettings": {
    "BaseUrl": "https://your-server-url.com/api/endpoint",
    "Username": "user",
    "Password": "password",
    "UseGrpc": false,
    "GrpcAddress": "https://localhost:5001"
  },
  "Logging": {
    "LogDirectory": "Logs",
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithProcessId" ],
    "Properties": {
      "Application": "SmsTestConsole"
    }
  }
}